{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "minota-cc",
    "main": ".svelte-kit/cloudflare/_worker.js",
    "compatibility_date": "2026-10-06",
    "observability": {
      "enabled": true
    },
    "assets": {
      "binding": "ASSETS",
      "directory": ".svelte-kit/cloudflare"
    }
  }